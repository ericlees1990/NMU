{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "NEW MATERIALS UNION UI Kit",
  "version": "1.0.0",
  "brand": "Scheme A",
  "description": "Design tokens for NEW MATERIALS UNION / 新材联 — AI-powered building industries. Logo fills black/white only; Blueprint Navy is accent only.",
  "color": {
    "black": { "value": "#000000", "type": "color", "role": "primary" },
    "white": { "value": "#FFFFFF", "type": "color", "role": "primary" },
    "navy": { "value": "#1E3A5F", "type": "color", "role": "accent", "note": "Links, focus ring, selected — never logo fill" },
    "steel": { "value": "#8A9199", "type": "color", "role": "neutral" },
    "surface": { "value": "#F5F6F7", "type": "color", "role": "surface" },
    "surface-muted": { "value": "#E8EAED", "type": "color", "role": "surface" },
    "danger": { "value": "#B42318", "type": "color", "role": "semantic" },
    "success": { "value": "#027A48", "type": "color", "role": "semantic" },
    "warning": { "value": "#B54708", "type": "color", "role": "semantic" }
  },
  "semantic": {
    "light": {
      "bg": "{color.white}",
      "bg-subtle": "{color.surface}",
      "bg-muted": "{color.surface-muted}",
      "bg-inverse": "{color.black}",
      "text": "{color.black}",
      "text-secondary": "{color.steel}",
      "text-inverse": "{color.white}",
      "border": "{color.surface-muted}",
      "border-strong": "{color.black}",
      "primary": "{color.black}",
      "primary-fg": "{color.white}",
      "accent": "{color.navy}",
      "accent-fg": "{color.white}",
      "danger": "{color.danger}",
      "success": "{color.success}",
      "focus-ring": "{color.navy}"
    },
    "dark": {
      "bg": "{color.black}",
      "bg-subtle": "#0A0A0A",
      "bg-muted": "#1A1A1A",
      "bg-inverse": "{color.white}",
      "text": "{color.white}",
      "text-secondary": "{color.steel}",
      "text-inverse": "{color.black}",
      "border": "#2A2A2A",
      "border-strong": "{color.white}",
      "primary": "{color.white}",
      "primary-fg": "{color.black}",
      "accent": "#4A7BA7",
      "accent-fg": "{color.white}",
      "danger": "#F04438",
      "success": "#32D583",
      "focus-ring": "#4A7BA7"
    }
  },
  "typography": {
    "fontFamily": {
      "en": { "value": "Montserrat, Inter, \"Helvetica Neue\", Arial, sans-serif" },
      "zh": { "value": "\"Noto Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", system-ui, sans-serif" },
      "mono": { "value": "\"IBM Plex Mono\", \"SF Mono\", Menlo, Consolas, monospace" }
    },
    "scale": {
      "display": { "size": "40px", "lineHeight": "1.2", "weight": 600, "letterSpacing": "0.02em" },
      "h1": { "size": "32px", "lineHeight": "1.25", "weight": 600, "letterSpacing": "0.01em" },
      "h2": { "size": "24px", "lineHeight": "1.3", "weight": 600, "letterSpacing": "0.01em" },
      "h3": { "size": "18px", "lineHeight": "1.35", "weight": 600, "letterSpacing": "0.01em" },
      "body": { "size": "14px", "lineHeight": "1.55", "weight": 400, "letterSpacing": "0" },
      "body-lg": { "size": "16px", "lineHeight": "1.55", "weight": 400, "letterSpacing": "0" },
      "caption": { "size": "12px", "lineHeight": "1.45", "weight": 400, "letterSpacing": "0.01em" },
      "label": { "size": "12px", "lineHeight": "1.3", "weight": 500, "letterSpacing": "0.04em", "transform": "uppercase" }
    }
  },
  "spacing": {
    "scale": [4, 8, 12, 16, 24, 32, 48],
    "unit": "px",
    "tokens": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px",
      "7": "48px"
    }
  },
  "radius": {
    "none": "0",
    "sm": "2px",
    "md": "4px",
    "full": "9999px",
    "note": "Prefer flat + 1px borders; radius is minimal"
  },
  "elevation": {
    "none": "none",
    "border": "0 0 0 1px var(--nmu-border)",
    "border-strong": "0 0 0 1px var(--nmu-border-strong)",
    "note": "No soft shadows; use 1px borders for separation"
  },
  "motion": {
    "duration-fast": "120ms",
    "duration": "180ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "control": {
    "height-sm": "32px",
    "height-md": "40px",
    "height-lg": "48px",
    "border-width": "1px",
    "focus-ring-width": "2px",
    "focus-ring-offset": "2px"
  }
}
